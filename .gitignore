# Repository root for the whole Chubb project: backend-claim-management/ and frontend/ each keep their own .gitignore
# (build output, node_modules, IDE files of their own). These are the things that only exist at this level.

# IntelliJ project of this folder
/.idea/
/*.iml
/out/

# Stray Playwright output when a test run starts from here instead of from frontend/
/test-results/
/playwright-report/
